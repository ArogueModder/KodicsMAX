<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.image.kodicsMAX" name="KodicsMAX" version="0.3.0" provider-name="typewriterMonkey, ArogueModder">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.pil" version="5.1.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py" provides="image"/>
    <extension point="xbmc.addon.metadata">
        <summary>Comic reader for Kodi. Includes a Library, Auto-Page Saving, Thumbnails, and native CBR/CBZ Support.</summary>
        <description>KodicsMax is an addon for Kodi created for reading comic books.  It includes native support for .CBR and .CBZ file formats, options for scrolling, a library with thumbnail support, Auto-page saving, and much more.</description>
        <platform>all</platform>
        <license>GPL v3</license>
        <source>https://github.com/ArogueModder/KodicsMAX</source>
        <assets>
            <icon>resources/media/icon.png</icon>
            <screenshot>resources/Screenshots/Screen1.png</screenshot>
            <screenshot>resources/Screenshots/Screen2.png</screenshot>
            <screenshot>resources/Screenshots/Screen3.png</screenshot>
        </assets>
    </extension>
</addon>
